# Core Settings
DEBUG=False
SECRET_KEY=${SECRET_KEY}  # Will be set in Render dashboard
ALLOWED_HOSTS=.onrender.com,localhost,127.0.0.1
ENVIRONMENT=production

# Database (for PostgreSQL on Render)
# DATABASE_URL will be automatically provided by Render for PostgreSQL
# SQLite fallback (not recommended for production)
DATABASE_URL=sqlite:///db.sqlite3

# Email Configuration (update with your email service)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=${EMAIL_HOST_USER}  # Set in Render dashboard
EMAIL_HOST_PASSWORD=${EMAIL_HOST_PASSWORD}  # Set in Render dashboard
DEFAULT_FROM_EMAIL=${DEFAULT_FROM_EMAIL}  # Set in Render dashboard

# Static Files
STATIC_URL=/static/
STATIC_ROOT=staticfiles/

# Security Settings
CSRF_TRUSTED_ORIGINS=https://*.onrender.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS='DENY'
SECURE_HSTS_SECONDS=31536000  # 1 year
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True